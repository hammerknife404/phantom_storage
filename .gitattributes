# Normalise text to LF in the repo; scripts keep the endings their shells need.
* text=auto
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

*.png binary
*.webp binary
*.jar binary

# Generated files always come out with LF.
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf
